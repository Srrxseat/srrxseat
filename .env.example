# Telegram bot — คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ถูก gitignore ไว้แล้ว)
# 1. ทักคุยกับ @BotFather ใน Telegram -> /newbot -> ได้ token มาใส่ตรงนี้
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# 2. ทักบอทด้วย /start แล้วรัน `python telegram/bot.py --whoami` เพื่อดู chat id
TELEGRAM_CHAT_ID=123456789
