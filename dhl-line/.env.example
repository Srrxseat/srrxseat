# ---------- LINE Messaging API ----------
# สร้าง Channel แบบ Messaging API ที่ https://developers.line.biz/console/
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# เฉพาะ LINE user id / group id เหล่านี้ที่สั่งงานได้ (คั่นด้วย comma, ว่าง = ไม่จำกัด)
LINE_ALLOWED_SOURCE_IDS=

# ---------- เซิร์ฟเวอร์ ----------
PORT=3000
DATA_DIR=./data

# ---------- โหมดสร้าง Shipment: api | web ----------
DHL_MODE=api

# ---- โหมด api (MyDHL API) ----
DHL_API_BASE=https://express.api.dhl.com/mydhlapi
DHL_API_USERNAME=
DHL_API_PASSWORD=
DHL_ACCOUNT_NUMBER=
# P = Express Worldwide (dutiable), D = Express Worldwide (document), N = Domestic Express
DHL_PRODUCT_CODE=P
DHL_LABEL_FORMAT=PDF
DHL_INCOTERM=DAP
DHL_UNIT_OF_MEASUREMENT=metric
DHL_TZ_OFFSET=+07:00
# true = ขอให้ DHL มารับพัสดุ, false = เอาไปส่งเอง/มีรอบรับประจำ
DHL_PICKUP_REQUESTED=false
# ECOM26_84_A4_001 = A4, ECOM26_84_001 = 10x15 ซม. (label printer)
DHL_LABEL_TEMPLATE=ECOM26_84_A4_001

# ---- โหมด web (กรอกฟอร์มบน mydhl.express.dhl ด้วย Playwright) ----
DHL_WEB_URL=https://mydhl.express.dhl/th/en/home.html
DHL_WEB_USERNAME=
DHL_WEB_PASSWORD=
# false = เปิดหน้าจอ browser ให้ช่วยทำ OTP/CAPTCHA เองได้
DHL_WEB_HEADLESS=true

# ---------- ข้อมูลผู้ส่ง (ใช้ทุกโหมด) ----------
SHIPPER_NAME=
SHIPPER_COMPANY=
SHIPPER_PHONE=
SHIPPER_EMAIL=
SHIPPER_ADDRESS1=
SHIPPER_ADDRESS2=
SHIPPER_CITY=
SHIPPER_STATE=
SHIPPER_POSTAL_CODE=
SHIPPER_COUNTRY_CODE=TH

# ---------- เครื่องพิมพ์: cups | printnode | none ----------
PRINT_MODE=cups

# ---- โหมด cups (เครื่องพิมพ์ในวง LAN หรือ CUPS server เครื่องอื่น) ----
# ชื่อคิวพิมพ์ เช่น DHL_Label หรือ Zebra_GK420d
CUPS_PRINTER=
# ถ้าเครื่องพิมพ์อยู่กับ CUPS server อีกเครื่อง ใส่ host[:port] เช่น 192.168.1.50:631
CUPS_HOST=
# ตัวเลือกเพิ่มเติมของ lp เช่น "-o media=A4 -o fit-to-page"
CUPS_OPTIONS=-o media=A4 -o fit-to-page

# ---- โหมด printnode (พิมพ์ข้ามเน็ตเวิร์กผ่าน printnode.com) ----
PRINTNODE_API_KEY=
PRINTNODE_PRINTER_ID=

PRINT_COPIES=1
