# --- Server ---
PORT=3000

# --- LINE Messaging API (from developers.line.biz console) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Comma-separated LINE group IDs to listen to. Leave empty to accept every group/room the bot is in.
ALLOWED_GROUP_IDS=

# --- Google Gemini (document scanning, free tier) ---
GEMINI_API_KEY=
# "-latest" always points at the current flash model, so it won't break when
# a pinned version (e.g. gemini-2.5-flash) is eventually retired. Run
# `node scripts/list-gemini-models.js` to see every model your key can use.
GEMINI_MODEL=gemini-flash-latest

# --- Google (Drive + Sheets) ---
# OAuth client from Google Cloud Console (APIs & Services > Credentials > Create
# Credentials > OAuth client ID > Desktop app). Run `node scripts/get-refresh-token.js`
# after filling in the client ID/secret below to get the refresh token.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Documents
