# --- Server ---
PORT=3000

# --- LINE Messaging API (from developers.line.biz console) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Comma-separated LINE group IDs to listen to. Leave empty to accept every group/room the bot is in.
ALLOWED_GROUP_IDS=

# --- Anthropic (document scanning) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Google (Drive + Sheets) ---
# Option A: paste the full service-account JSON key as one line here.
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
# Option B: instead of the above, point to a mounted key file.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Documents
