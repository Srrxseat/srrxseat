# --- Server ---
PORT=3000

# --- LINE Messaging API (from developers.line.biz console) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Comma-separated LINE group IDs to listen to. Leave empty to accept every group/room the bot is in.
ALLOWED_GROUP_IDS=

# --- Anthropic Claude (document scanning) ---
ANTHROPIC_API_KEY=
# Optional. Leave unset to use the default in src/config.js (claude-opus-5),
# which reads small handwritten checkboxes and scrawled dates most accurately.
# Uncomment to trade some of that accuracy back for a lower per-image cost.
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Google (Drive + Sheets) ---
# OAuth client from Google Cloud Console (APIs & Services > Credentials > Create
# Credentials > OAuth client ID > Desktop app). Run `node scripts/get-refresh-token.js`
# after filling in the client ID/secret below to get the refresh token.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Documents
# Separate tab for the drop-in attendance sheet (one photo = many rows).
GOOGLE_SHEET_LOG_TAB_NAME=Drop-in Log

# --- Monthly report ---
# Groups the month-end drop-in report is pushed to (comma separated). Falls
# back to ALLOWED_GROUP_IDS; with neither set, the month-end send is off.
REPORT_GROUP_IDS=
# Hour of the last day of the month (Thailand time) to send it. Default 20.
REPORT_HOUR=

# --- Public pages ---
# Optional. Contact address shown on the homepage and privacy policy that the
# service hosts at / and /privacy (the two URLs Google's OAuth consent screen
# requires). Left blank, those pages use generic wording instead.
SUPPORT_EMAIL=
