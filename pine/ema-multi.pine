//@version=6
// EMA Multi 7/14/25/50/100/200
// วาง EMA 6 เส้นในตัวเดียว ปรับความยาว/สี/เปิด-ปิดได้ทุกเส้น
// รองรับล็อก timeframe (ดู EMA ของ TF ใหญ่บนกราฟเล็ก) และมี alert ตัดกัน
indicator("EMA Multi 7/14/25/50/100/200", shorttitle = "EMA x6", overlay = true, max_labels_count = 100)

// ─── การตั้งค่าทั่วไป ────────────────────────────────────────────────
grpGen = "ทั่วไป"
src      = input.source(close, "แหล่งราคา",                group = grpGen)
tf       = input.timeframe("", "ล็อก Timeframe (ว่าง = ตามกราฟ)", group = grpGen)
showLbl  = input.bool(true,  "แสดงป้ายชื่อท้ายเส้น",        group = grpGen)
showTbl  = input.bool(true,  "แสดงตารางสรุป",               group = grpGen)
tblPos   = input.string("ขวาบน", "ตำแหน่งตาราง", options = ["ขวาบน", "ขวาล่าง", "ซ้ายบน", "ซ้ายล่าง"], group = grpGen)
showFill = input.bool(true,  "ระบายสีระหว่าง EMA เร็ว-ช้า",  group = grpGen)
lineW    = input.int(2, "ความหนาเส้น", minval = 1, maxval = 4, group = grpGen)

// ─── เส้น EMA ───────────────────────────────────────────────────────
grpEma = "เส้น EMA"
on1 = input.bool(true, "", inline = "e1", group = grpEma)
l1  = input.int(7,     "EMA", inline = "e1", minval = 1, group = grpEma)
c1  = input.color(color.new(#00E5FF, 0), "", inline = "e1", group = grpEma)

on2 = input.bool(true, "", inline = "e2", group = grpEma)
l2  = input.int(14,    "EMA", inline = "e2", minval = 1, group = grpEma)
c2  = input.color(color.new(#4CFF6A, 0), "", inline = "e2", group = grpEma)

on3 = input.bool(true, "", inline = "e3", group = grpEma)
l3  = input.int(25,    "EMA", inline = "e3", minval = 1, group = grpEma)
c3  = input.color(color.new(#FFD400, 0), "", inline = "e3", group = grpEma)

on4 = input.bool(true, "", inline = "e4", group = grpEma)
l4  = input.int(50,    "EMA", inline = "e4", minval = 1, group = grpEma)
c4  = input.color(color.new(#FF9800, 0), "", inline = "e4", group = grpEma)

on5 = input.bool(true, "", inline = "e5", group = grpEma)
l5  = input.int(100,   "EMA", inline = "e5", minval = 1, group = grpEma)
c5  = input.color(color.new(#E040FB, 0), "", inline = "e5", group = grpEma)

on6 = input.bool(true, "", inline = "e6", group = grpEma)
l6  = input.int(200,   "EMA", inline = "e6", minval = 1, group = grpEma)
c6  = input.color(color.new(#FF5252, 0), "", inline = "e6", group = grpEma)

// ─── คำนวณ (รองรับ MTF, ไม่ repaint: lookahead ปิด) ──────────────────
tfUse = tf == "" ? timeframe.period : tf
f_ema(int len) =>
    request.security(syminfo.tickerid, tfUse, ta.ema(src, len), lookahead = barmerge.lookahead_off)

e1 = f_ema(l1)
e2 = f_ema(l2)
e3 = f_ema(l3)
e4 = f_ema(l4)
e5 = f_ema(l5)
e6 = f_ema(l6)

// ─── วาดเส้น ────────────────────────────────────────────────────────
p1 = plot(on1 ? e1 : na, "EMA เส้น 1", c1, lineW)
p2 = plot(on2 ? e2 : na, "EMA เส้น 2", c2, lineW)
plot(on3 ? e3 : na, "EMA เส้น 3", c3, lineW)
plot(on4 ? e4 : na, "EMA เส้น 4", c4, lineW)
plot(on5 ? e5 : na, "EMA เส้น 5", c5, lineW)
p6 = plot(on6 ? e6 : na, "EMA เส้น 6", c6, lineW)

// ระบายสีระหว่างเส้นเร็วสุดกับช้าสุด: เขียว = ขาขึ้น, แดง = ขาลง
fillCol = not showFill ? na : (e1 > e6 ? color.new(color.green, 88) : color.new(color.red, 88))
fill(p1, p6, fillCol, title = "โซนแนวโน้ม")

// ─── ป้ายชื่อท้ายเส้น ───────────────────────────────────────────────
f_label(bool on, float val, int len, color col) =>
    var label lb = na
    if barstate.islast
        label.delete(lb)
        if on and not na(val)
            lb := label.new(bar_index + 3, val, "EMA " + str.tostring(len), xloc.bar_index,
                 yloc.price, color.new(col, 85), label.style_label_left, col, size.small)

f_label(showLbl and on1, e1, l1, c1)
f_label(showLbl and on2, e2, l2, c2)
f_label(showLbl and on3, e3, l3, c3)
f_label(showLbl and on4, e4, l4, c4)
f_label(showLbl and on5, e5, l5, c5)
f_label(showLbl and on6, e6, l6, c6)

// ─── ตารางสรุป: ราคาอยู่เหนือ/ใต้แต่ละเส้น + คะแนนแนวโน้ม ───────────
pos = switch tblPos
    "ขวาบน"   => position.top_right
    "ขวาล่าง" => position.bottom_right
    "ซ้ายบน"  => position.top_left
    =>           position.bottom_left

var table tbl = table.new(pos, 3, 8, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 50))

f_row(int r, bool on, string name, float val, color col) =>
    if on and not na(val)
        above = close > val
        table.cell(tbl, 0, r, name, text_color = col, text_size = size.small, bgcolor = color.new(#131722, 20))
        table.cell(tbl, 1, r, str.tostring(val, format.mintick), text_color = color.white, text_size = size.small, bgcolor = color.new(#131722, 20))
        table.cell(tbl, 2, r, above ? "เหนือ" : "ใต้", text_color = above ? color.lime : color.red, text_size = size.small, bgcolor = color.new(#131722, 20))

if showTbl and barstate.islast
    table.clear(tbl, 0, 0, 2, 7)
    // นับเส้นที่ราคายืนเหนือได้ = คะแนนแนวโน้ม
    score = (on1 and close > e1 ? 1 : 0) + (on2 and close > e2 ? 1 : 0) + (on3 and close > e3 ? 1 : 0) + (on4 and close > e4 ? 1 : 0) + (on5 and close > e5 ? 1 : 0) + (on6 and close > e6 ? 1 : 0)
    total = (on1 ? 1 : 0) + (on2 ? 1 : 0) + (on3 ? 1 : 0) + (on4 ? 1 : 0) + (on5 ? 1 : 0) + (on6 ? 1 : 0)
    stacked = e1 > e2 and e2 > e3 and e3 > e4 and e4 > e5 and e5 > e6
    stackedDn = e1 < e2 and e2 < e3 and e3 < e4 and e4 < e5 and e5 < e6
    trend = stacked ? "ขาขึ้นเรียงสวย" : stackedDn ? "ขาลงเรียงสวย" : "ไซด์เวย์ / สลับ"
    trendCol = stacked ? color.lime : stackedDn ? color.red : color.orange
    table.cell(tbl, 0, 0, "เส้น",  text_color = color.silver, text_size = size.small, bgcolor = color.new(color.gray, 70))
    table.cell(tbl, 1, 0, "ค่า",   text_color = color.silver, text_size = size.small, bgcolor = color.new(color.gray, 70))
    table.cell(tbl, 2, 0, "ราคา", text_color = color.silver, text_size = size.small, bgcolor = color.new(color.gray, 70))
    f_row(1, on1, "EMA " + str.tostring(l1), e1, c1)
    f_row(2, on2, "EMA " + str.tostring(l2), e2, c2)
    f_row(3, on3, "EMA " + str.tostring(l3), e3, c3)
    f_row(4, on4, "EMA " + str.tostring(l4), e4, c4)
    f_row(5, on5, "EMA " + str.tostring(l5), e5, c5)
    f_row(6, on6, "EMA " + str.tostring(l6), e6, c6)
    table.cell(tbl, 0, 7, trend, text_color = trendCol, text_size = size.small, bgcolor = color.new(#131722, 20))
    table.cell(tbl, 1, 7, "เหนือ " + str.tostring(score) + "/" + str.tostring(total), text_color = color.white, text_size = size.small, bgcolor = color.new(#131722, 20))
    table.cell(tbl, 2, 7, "", bgcolor = color.new(#131722, 20))

// ─── สัญญาณ / Alert ─────────────────────────────────────────────────
goldenX = ta.crossover(e2, e4)                  // EMA 14 ตัดขึ้น EMA 50
deathX  = ta.crossunder(e2, e4)
fastX   = ta.crossover(e1, e3)                  // EMA 7 ตัดขึ้น EMA 25
fastXdn = ta.crossunder(e1, e3)
above200 = ta.crossover(close, e6)
below200 = ta.crossunder(close, e6)

alertcondition(fastX,    "EMA เร็วตัดขึ้น",   "EMA 7 ตัดขึ้น EMA 25")
alertcondition(fastXdn,  "EMA เร็วตัดลง",     "EMA 7 ตัดลง EMA 25")
alertcondition(goldenX,  "Golden Cross",      "EMA 14 ตัดขึ้น EMA 50")
alertcondition(deathX,   "Death Cross",       "EMA 14 ตัดลง EMA 50")
alertcondition(above200, "ราคายืนเหนือ EMA 200", "ราคาตัดขึ้นเหนือ EMA 200")
alertcondition(below200, "ราคาหลุด EMA 200",     "ราคาตัดลงใต้ EMA 200")
